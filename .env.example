# Required
GOOGLE_API_KEY=your-gemini-api-key
DATABASE_URL=sqlite:///./melodycare.db        # or postgresql://user:password@host/dbname
SECRET_KEY=generate-a-long-random-string      # signs login tokens

# Optional: demo logins created by `python src/seed.py` (random ones are printed if unset)
SEED_PARENT_PASSWORD=
SEED_ADMIN_PASSWORD=

# Optional: models (these are the defaults)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_GUEST_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-2.5-flash

# Optional: visitor chat limits (defaults shown)
GUEST_IP_DAILY=30
GUEST_GLOBAL_DAILY=400

# Optional: public API. Create keys with `python src/make_api_key.py <name> [website]`
API_KEYS=
API_ORIGINS=
API_KEY_PER_MIN=10
API_KEY_DAILY=200
API_GLOBAL_DAILY=600
